# Snowflake — JSA-ANALYTICS account, EXPORTER_SVC service user
SNOWFLAKE_ACCOUNT=JSA-ANALYTICS
SNOWFLAKE_USER=EXPORTER_SVC
SNOWFLAKE_ROLE=EXPORTER_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_PRIVATE_KEY_PATH=/root/.snowflake/exporter_svc.p8
# SNOWFLAKE_PRIVATE_KEY=<base64-encoded key — alternative to path>
# SNOWFLAKE_PRIVATE_KEY_PWD=<passphrase if key is encrypted>

# TDM (ETL only — not needed by the Streamlit app)
TDM_PASSWORD=<your TDM password>

# Email (ETL only — Graph creds shared from /opt/basis-tracker/.env)
RECIPIENT_EMAIL=jsagroup@jpsi.com
# GRAPH_FROM_NAME=JSA Export Monitor
